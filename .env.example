# 本文件只展示变量名称和示例，不能存放真实密钥或密码。

# 本地默认设置模块；部署时改为 config.settings.production。
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 本地默认使用 sqlite。切换 PostgreSQL 时改为 postgresql 并填写全部字段。
DATABASE_ENGINE=sqlite
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432

# 生产HTTPS部署时按真实域名和代理配置填写。
CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_HTTPS_ENABLED=false
DJANGO_TRUST_PROXY_HEADER=false
