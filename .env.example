# 复制为 .env 后替换全部示例密钥。不要提交 .env。
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django连接PostgreSQL；Compose内主机必须是服务名db。
DATABASE_ENGINE=postgresql
DATABASE_NAME=personal_platform
DATABASE_USER=personal_platform_user
DATABASE_PASSWORD=replace-with-a-secure-password
DATABASE_HOST=db
DATABASE_PORT=5432

# PostgreSQL首次初始化；值应与上面的Django数据库变量一致。
POSTGRES_DB=personal_platform
POSTGRES_USER=personal_platform_user
POSTGRES_PASSWORD=replace-with-a-secure-password

# 本地Compose端口。数据库端口默认不暴露给宿主机。
WEB_PORT=8000

# 正式HTTPS部署后再调整。
CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS_ENABLED=false
DJANGO_TRUST_PROXY_HEADER=false

# 仅供本地Compose演示上传媒体；公网应使用持久磁盘配合专用媒体服务或对象存储。
DJANGO_SERVE_MEDIA=true
